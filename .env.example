# 占位示例；无真实凭据。启动前以 scripts/import-env.ps1 显式导入当前进程。
ORDIVANE_PG_HOST=127.0.0.1
ORDIVANE_PG_PORT=5432
ORDIVANE_PG_ADMIN_PASSWORD=replace-me
ORDIVANE_PLATFORM_DB_PASSWORD=replace-me
ORDIVANE_DEMO_DB_PASSWORD=replace-me
ORDIVANE_MQ_PASSWORD=replace-me
ORDIVANE_RABBITMQ_URI=amqp://ordivane:replace-me@localhost:5672/
ORDIVANE_DEMO_API_TOKEN=replace-me
# model.enabled=false 时模型字段不要求解析；启用时必须填写非占位值。
ORDIVANE_MODEL_BASE_URL=https://example.invalid/v1
ORDIVANE_MODEL_NAME=replace-me
ORDIVANE_MODEL_API_KEY=replace-me
# BE-020：仅local且显式true才初始化三个人类账号和一个独立来源；空值不可登录。
ORDIVANE_ACCESS_INITIALIZE=false
ORDIVANE_ACCESS_OBSERVER_USERNAME=
ORDIVANE_ACCESS_OBSERVER_PASSWORD=
ORDIVANE_ACCESS_OPERATOR_USERNAME=
ORDIVANE_ACCESS_OPERATOR_PASSWORD=
ORDIVANE_ACCESS_APPROVER_USERNAME=
ORDIVANE_ACCESS_APPROVER_PASSWORD=
# 来源ID不是用户名；来源凭据须由安全随机生成器产生至少32字符，不与密码共用。
ORDIVANE_ACCESS_SOURCE_ID=
ORDIVANE_ACCESS_SOURCE_CREDENTIAL=
# 非local默认true；local HTTP由application-local.yml关闭，部署HTTPS应保持true。
ORDIVANE_ACCESS_COOKIE_SECURE=true
# BE-011：默认关闭HTTP报告发送；启用时配置已登记于BE-020的独立来源，不使用演示API token。
ORDIVANE_REPORT_ENABLED=false
ORDIVANE_REPORT_ENDPOINT=
ORDIVANE_REPORT_SOURCE_ID=ordivane-demo
ORDIVANE_REPORT_SOURCE_CREDENTIAL=
# BE-030：只消费显式登记且broker写权限受控的队列；不默认接入开发队列。
ORDIVANE_INGESTION_ENABLED=false
ORDIVANE_INGESTION_QUEUE=ordivane.ingestion.disabled
ORDIVANE_INGESTION_SOURCE=
ORDIVANE_INGESTION_HANDLER=membership.activate
# 仅可信演示HTTP地址；服务token沿用ORDIVANE_DEMO_API_TOKEN，非报告Bearer或人类密码。
ORDIVANE_DEMO_BASE_URL=http://127.0.0.1:8081

# 新平台启动配置工作根，包含ordivane.yml/scenarios/schemas/prompts/runbooks；不自动读取.env。
ORDIVANE_CONFIGURATION_ROOT=E:/Ordivane

# BE-060：恢复发送默认关闭；不确定发送不自动重试，资格保留至后继安全核验。
ORDIVANE_EXECUTION_WORKER_ENABLED=false
ORDIVANE_EXECUTION_OUTBOX_ENABLED=false
ORDIVANE_EXECUTION_DELAY_MS=1000
ORDIVANE_EXECUTION_BATCH_SIZE=10
ORDIVANE_EXECUTION_LEASE_SECONDS=30
ORDIVANE_EXECUTION_CONFIRM_TIMEOUT_MS=5000
# 仅local显式映射到ordivane.test.be060.<runId>；生产目标不可覆盖，无新增秘密。
ORDIVANE_EXECUTION_LOCAL_MAPPING_ENABLED=false
ORDIVANE_EXECUTION_LOCAL_PREFIX=

# BE-061：只读核验调度默认关闭；间隔1..300秒，期限2..86400秒，次数1..20。
ORDIVANE_EXECUTION_RESULT_WORKER_ENABLED=false
ORDIVANE_EXECUTION_RESULT_DELAY_MS=1000
ORDIVANE_EXECUTION_RESULT_INTERVAL_SECONDS=10
ORDIVANE_EXECUTION_RESULT_DEADLINE_SECONDS=300
ORDIVANE_EXECUTION_RESULT_MAX_ATTEMPTS=6
