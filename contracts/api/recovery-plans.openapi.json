          "actionDigest",
          "digest",
          "createdAt",
          "expiresAt",
          "recordedStatus",
          "status",
          "executionAuthorized",
          "decisions",
          "approvalRequests",
          "prechecks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "incidentId": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "previousId": {
            "oneOf": [
              {
                "type": "string",
                "format": "uuid"
              },
