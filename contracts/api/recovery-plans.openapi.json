    "schemas": {
      "Exact": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "digest"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "Previous": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "digest"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "Create": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "parameters",
          "evidenceIds",
          "previous"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "REPLAY_ORIGINAL",
              "VERIFY_ONLY",
              "WAIT_AND_RECHECK",
              "MANUAL_INTERVENTION"
            ]
          },
          "parameters": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {}
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "delaySeconds"
                ],
                "properties": {
                  "delaySeconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3600
                  }
                }
              }
            ]
          },
          "evidenceIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "previous": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Previous"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "const": "WAIT_AND_RECHECK"
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "delaySeconds"
                  ],
                  "properties": {
                    "delaySeconds": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 3600
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "parameters": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [],
                  "properties": {}
                }
              }
            }
          }
        ]
      },
      "RequestApproval": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "digest",
          "precheckId"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "precheckId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Decision": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "digest",
          "decision"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "decision": {
            "type": "string",
            "enum": [
              "APPROVE",
              "REJECT"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "traceId"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "traceId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
