{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "scenario_directory",
    "connections",
    "model",
    "registry",
    "safety"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "display_name"
      ],
      "properties": {
        "name": {
          "const": "Ordivane"
        },
        "display_name": {
          "const": "缀衡"
        }
      }
    },
    "scenario_directory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "connections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rabbitmq",
        "membership"
      ],
      "properties": {
        "rabbitmq": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uri",
            "dead_letter_queue",
            "source_id"
          ],
          "properties": {
            "uri": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "dead_letter_queue": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "source_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        },
        "membership": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base_url",
            "api_token"
          ],
          "properties": {
            "base_url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "api_token": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "request_timeout_seconds"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "base_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "model_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "api_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "request_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "base_url",
              "model_name",
              "api_key"
            ]
          }
        }
      ]
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tools",
        "checks",
        "replay_targets",
        "verifiers"
      ],
      "properties": {
        "tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 32
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 32
        },
        "replay_targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "exchange",
              "routing_key",
              "queue"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "exchange": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "routing_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "queue": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            }
          },
          "maxItems": 32,
          "uniqueItems": true
        },
        "verifiers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 32
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replay_approval_required",
        "forbid_self_approval",
        "preserve_original_payload",
        "recheck_before_execution"
      ],
      "properties": {
        "replay_approval_required": {
          "const": true
        },
        "forbid_self_approval": {
          "const": true
        },
        "preserve_original_payload": {
          "const": true
        },
        "recheck_before_execution": {
          "const": true
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ordivane ordivane configuration v1"
}
