{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "match",
        "evidence_tools",
        "diagnosis",
        "recovery",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 2048
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "event_type",
            "schema_version",
            "handler"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "event_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "schema_version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "handler": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        },
        "evidence_tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 32
        },
        "diagnosis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prompt",
            "runbooks",
            "tools",
            "max_tool_calls",
            "max_model_requests",
            "timeout_seconds"
          ],
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "runbooks": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "maxItems": 32
            },
            "tools": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "maxItems": 32
            },
            "max_tool_calls": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "max_model_requests": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            }
          }
        },
        "recovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed_actions",
            "replay_target",
            "replay_prechecks",
            "plan_ttl_seconds",
            "approval"
          ],
          "properties": {
            "allowed_actions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "REPLAY_ORIGINAL",
                  "VERIFY_ONLY",
                  "WAIT_AND_RECHECK",
                  "MANUAL_INTERVENTION"
                ]
              },
              "maxItems": 32
            },
            "replay_target": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "replay_prechecks": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "maxItems": 32
            },
            "plan_ttl_seconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 86400
            },
            "approval": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "required_for",
                "roles",
                "forbid_self_approval"
              ],
              "properties": {
                "required_for": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "REPLAY_ORIGINAL",
                      "VERIFY_ONLY",
                      "WAIT_AND_RECHECK",
                      "MANUAL_INTERVENTION"
                    ]
                  },
                  "maxItems": 32
                },
                "roles": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "const": "APPROVER"
                  },
                  "maxItems": 32
                },
                "forbid_self_approval": {
                  "const": true
                }
              }
            }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verifier",
            "interval_seconds",
            "timeout_seconds"
          ],
          "properties": {
            "verifier": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "interval_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ordivane scenario configuration v1"
}
