{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "verbatimModuleSyntax": true,
    "types": ["vite/client", "node", "web-bluetooth", "vue/jsx"],
    "paths": {
      "element-plus/es/icons-vue": ["./node_modules/@element-plus/icons-vue/dist/types/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
